<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#123a70"><title>PAK GRADE 10 | Maths</title><style>
*{box-sizing:border-box}body{margin:0;background:#f3f6fb;color:#14243a;font-family:system-ui,Arial,sans-serif}header{padding:22px 18px;background:linear-gradient(130deg,#102d56,#2563eb);color:#fff}header h1{margin:0}main{max-width:850px;margin:auto;padding:14px}nav{display:flex;gap:8px;overflow:auto;padding-bottom:12px}button{cursor:pointer}nav button,.primary,.secondary{border:0;border-radius:10px;padding:11px 14px;font-weight:700}nav button{background:white;color:#123a70;border:1px solid #dbe4ef;white-space:nowrap}nav button.active,.primary{background:#2563eb;color:white}.secondary{background:#e9f1ff;color:#123a70}.card,.topic{background:white;border:1px solid #dbe4ef;border-radius:14px;padding:15px;margin:10px 0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}.topic{text-align:left;color:#14243a}.topic strong{display:block;margin-bottom:5px}.muted{color:#617086}.hidden{display:none}.option{display:block;padding:10px;border:1px solid #dbe4ef;border-radius:9px;margin:7px 0}.feedback{background:#eef4ff;padding:12px;border-radius:10px}footer{text-align:center;padding:20px;color:#66758b}
</style></head><body><header><h1>📘 PAK GRADE 10</h1><p>Free learning for every learner · Mathematics</p></header><main><nav id="tabs"><button class="active" data-view="home">Home</button><button data-view="topics">Topics</button><button data-view="quiz">Quiz</button><button data-view="progress">My Progress</button></nav>
<section id="home" class="view"><div class="card"><h2>Welcome to your Maths study room</h2><p>Learn one topic at a time, read worked examples, and check your understanding with short quizzes.</p><p><b>Learning path:</b> Real Numbers → Algebra → Equations → Indices → Percentages → Geometry → Statistics → Probability.</p><button class="primary" onclick="showView('topics')">Start learning</button></div><div class="card"><h3>Study tip</h3><p>Try each example yourself before looking at the solution. Write down your working, not only final answers.</p></div></section>
<section id="topics" class="view hidden"><h2>Mathematics topics</h2><div id="topicGrid" class="grid"></div><div id="lessonPanel" class="card hidden"></div></section>
<section id="quiz" class="view hidden"><div class="card"><h2>Quick Mathematics Quiz</h2><p class="muted">10 questions · Select answers, then submit.</p><div id="quizArea"></div><button class="primary" id="submitQuiz">Submit quiz</button><div id="quizResult" class="feedback hidden"></div></div></section>
<section id="progress" class="view hidden"><div class="card"><h2>Your learning progress</h2><p>Quizzes completed: <b id="completed">0</b></p><p>Best score: <b id="best">0%</b></p><p>Topics opened: <b id="opened">0</b></p><button class="secondary" onclick="resetProgress()">Reset progress</button><p class="muted">Saved on this device/browser.</p></div></section></main><footer>PAK GRADE 10 · Learn today, lead tomorrow.</footer>
<script>
const lessons=[
{title:'1. Real Numbers',summary:'Rational, irrational, integer and decimal numbers.',notes:'Real numbers include rational and irrational numbers. Rational numbers can be written as fractions of integers, such as 3/4, −2, or 0.25. Irrational numbers cannot be written as such a fraction; examples include √2 and π.',example:'0.75 = 75/100 = 3/4, so it is rational. √7 is irrational.',practice:'Classify −6 and √5.',answer:'−6 is an integer (also rational); √5 is irrational.'},
{title:'2. Algebraic Expressions',summary:'Variables, coefficients and like terms.',notes:'An expression combines numbers, variables and operations. Like terms have the same variable part and powers.',example:'4a + 3a − 2 = 7a − 2.',practice:'Simplify 5x + 2x − 4.',answer:'7x − 4.'},
{title:'3. Linear Equations',summary:'Solve equations by keeping both sides balanced.',notes:'An equation states two expressions are equal. Perform the same operation on both sides to keep it balanced.',example:'3x + 5 = 20. Subtract 5: 3x = 15. Divide by 3: x = 5.',practice:'Solve 2x + 7 = 19.',answer:'2x = 12, so x = 6.'},
{title:'4. Indices (Powers)',summary:'Apply the basic laws of exponents.',notes:'For the same base: aᵐ × aⁿ = aᵐ⁺ⁿ; aᵐ ÷ aⁿ = aᵐ⁻ⁿ (a ≠ 0); (aᵐ)ⁿ = aᵐⁿ; a⁰ = 1 when a ≠ 0.',example:'2³ × 2² = 2⁵ = 32.',practice:'Simplify 5² × 5³.',answer:'5⁵ = 3125.'},
{title:'5. Ratios and Percentages',summary:'Compare quantities and calculate percentages.',notes:'A ratio compares quantities. Simplify by dividing terms by their common factor. Percentage means per hundred. Find p% of a number by multiplying by p/100.',example:'15% of 200 = 15/100 × 200 = 30.',practice:'Find 20% of 150.',answer:'30.'},
{title:'6. Geometry',summary:'Angles and triangle properties.',notes:'Angles on a straight line sum to 180°. Angles around a point sum to 360°. Interior angles of a triangle sum to 180°. A right angle is 90°.',example:'Triangle angles 50° and 60°: third angle = 180° − 50° − 60° = 70°.',practice:'A triangle has angles 35° and 90°. Find the third angle.',answer:'180° − 35° − 90° = 55°.'},
{title:'7. Statistics',summary:'Mean, median, mode and range.',notes:'Mean = sum ÷ count. Median is the middle value after sorting. Mode is most frequent. Range = maximum − minimum.',example:'For 2, 3, 3, 7, 10: mean = 5; median = 3; mode = 3; range = 8.',practice:'Find the range of 4, 9, 1, 6.',answer:'9 − 1 = 8.'},
{title:'8. Probability',summary:'Describe the chance of an event.',notes:'Probability = favourable outcomes ÷ total equally likely outcomes. It ranges from 0 to 1. Zero means impossible; 1 means certain.',example:'A fair coin has two equally likely outcomes. P(heads) = 1/2.',practice:'A fair six-sided die is rolled. What is the probability of rolling 4?',answer:'1/6.'}];
function renderTopics(){document.getElementById('topicGrid').innerHTML=lessons.map((l,i)=>`<button class="topic" onclick="openLesson(${i})"><strong>${l.title}</strong><span class="muted">${l.summary}</span></button>`).join('')}
function openLesson(i){let l=lessons[i],p=document.getElementById('lessonPanel');p.classList.remove('hidden');p.innerHTML=`<h2>${l.title}</h2><p>${l.summary}</p><h3>Notes</h3><p>${l.notes}</p><h3>Worked example</h3><div class="feedback">${l.example}</div><h3>Try it</h3><p>${l.practice}</p><details><summary>Show answer</summary><p>${l.answer}</p></details>`;localStorage.setItem('pak_opened',Number(localStorage.getItem('pak_opened')||0)+1);updateProgress();p.scrollIntoView({behavior:'smooth'})}
const questions=[{q:'Solve: 3x + 5 = 20.',opts:['x = 3','x = 5','x = 15'],a:1,why:'Subtract 5: 3x = 15; divide by 3: x = 5.'},{q:'Simplify: 4a + 3a.',opts:['7','7a','12a'],a:1,why:'Combine like terms: 4a + 3a = 7a.'},{q:'Which is irrational?',opts:['0.5','√2','−4'],a:1,why:'√2 cannot be expressed as a ratio of integers.'},{q:'Find 15% of 200.',opts:['15','30','45'],a:1,why:'0.15 × 200 = 30.'},{q:'Angles in a triangle add up to:',opts:['90°','180°','360°'],a:1,why:'Triangle interior angles sum to 180°.'},{q:'Simplify 2³ × 2².',opts:['2⁵','2⁶','4⁵'],a:0,why:'Same base: add powers, 3 + 2 = 5.'},{q:'Median of 1, 3, 4, 8, 9?',opts:['3','4','5'],a:1,why:'The middle value in the ordered list is 4.'},{q:'A fair coin probability of heads:',opts:['1/4','1/2','1'],a:1,why:'Two equally likely sides, one is heads.'},{q:'Solve 2x + 7 = 19.',opts:['5','6','12'],a:1,why:'Subtract 7: 2x = 12; divide by 2: x = 6.'},{q:'Range of 4, 9, 1, 6?',opts:['6','7','8'],a:2,why:'Range = largest − smallest = 9 − 1 = 8.'}];
function renderQuiz(){document.getElementById('quizArea').innerHTML=questions.map((q,i)=>`<div class="card"><b>${i+1}. ${q.q}</b>${q.opts.map((o,j)=>`<label class="option"><input type="radio" name="q${i}" value="${j}"> ${o}</label>`).join('')}</div>`).join('')}
document.getElementById('submitQuiz').onclick=()=>{let score=0;questions.forEach((q,i)=>{let c=document.querySelector(`input[name=q${i}]:checked`);if(c&&+c.value===q.a)score++});let pct=Math.round(score/questions.length*100),r=document.getElementById('quizResult');r.classList.remove('hidden');r.innerHTML=`<h3>Score: ${score}/${questions.length} (${pct}%)</h3><p>${pct>=80?'Excellent! Keep practising.':pct>=50?'Good effort. Review and retry.':'Keep learning—review topics and try again.'}</p><hr>${questions.map((q,i)=>`<p>${i+1}. ${q.why}</p>`).join('')}`;localStorage.setItem('pak_quizzes',Number(localStorage.getItem('pak_quizzes')||0)+1);if(pct>Number(localStorage.getItem('pak_best')||0))localStorage.setItem('pak_best',pct);updateProgress();r.scrollIntoView({behavior:'smooth'})};
function showView(v){document.querySelectorAll('.view').forEach(s=>s.classList.add('hidden'));document.getElementById(v).classList.remove('hidden');document.querySelectorAll('#tabs button').forEach(b=>b.classList.toggle('active',b.dataset.view===v));if(v==='topics')renderTopics();if(v==='quiz')renderQuiz();if(v==='progress')updateProgress()}
document.querySelectorAll('#tabs button').forEach(b=>b.onclick=()=>showView(b.dataset.view));function updateProgress(){document.getElementById('completed').textContent=localStorage.getItem('pak_quizzes')||0;document.getElementById('best').textContent=(localStorage.getItem('pak_best')||0)+'%';document.getElementById('opened').textContent=localStorage.getItem('pak_opened')||0}function resetProgress(){if(confirm('Reset your saved progress?')){['pak_quizzes','pak_best','pak_opened'].forEach(k=>localStorage.removeItem(k));updateProgress()}}renderTopics();renderQuiz();updateProgress();
</script></body></html>
